# --- Monorepo ignores (любой уровень вложенности)
**/node_modules/
**/.next/
**/out/
**/dist/
**/build/
**/.turbo/
**/.vercel/

# env
**/.env
**/.env.*
!.env.example

# Logs & cache
**/.pnpm-store/
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*
**/.pnpm-debug.log*
**/.DS_Store

# IDE / tool state
.idea/
.vscode/
**/.expo/
.encoding-backup-*/

# Local device debugging artifacts (screenshots, UI dumps, logcat).
# Evidence worth keeping belongs in docs/evidence/.
apps/mobile/*.png
apps/mobile/*.xml
apps/mobile/*logcat*.txt

# Misc
coverage/

# Playwright
**/test-results/
**/playwright-report/
**/playwright/.cache/
.vercel
.env*.local
**/telegram-test.env.local
