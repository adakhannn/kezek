{
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "next": "16",
        "react": "19",
        "react-dom": "19",
        "tree-sitter": "0.22"
      }
    },
    "overrides": {
      "tar": "7.5.22",
      "@isaacs/brace-expansion": ">=5.0.1",
      "axios": "1.21.1",
      "@xmldom/xmldom@0.8": "0.8.15",
      "brace-expansion@1": "1.1.21",
      "brace-expansion@2": "2.1.7",
      "browserslist": "4.29.5",
      "compression": "1.8.2",
      "fast-uri": "3.1.9",
      "flatted": "3.4.4",
      "follow-redirects": "1.16.3",
      "form-data": "4.0.6",
      "handlebars": "4.7.10",
      "js-yaml@3": "3.15.2",
      "js-yaml@4": "4.3.2",
      "lodash": "4.18.1",
      "minimatch@3": "3.1.5",
      "minimatch@8": "8.0.7",
      "minimatch@9": "9.0.9",
      "minimatch@10": "10.2.6",
      "nanoid@3": "3.3.20",
      "node-forge": "1.4.3",
      "picomatch@2": "2.3.2",
      "@expo/cli>picomatch": "3.0.2",
      "picomatch@4": "4.0.7",
      "postcss": "8.5.23",
      "shell-quote": "1.12.0",
      "source-map-js": "1.2.2",
      "undici@6": "6.29.1",
      "ws@6": "6.2.6",
      "ws@7": "7.5.13",
      "ws@8": "8.22.2",
      "yaml@2": "2.9.1",
      "terser-webpack-plugin@5": "5.6.1"
    },
    "onlyBuiltDependencies": [
      "supabase"
    ],
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-qr28-fpjm-wq7f",
        "GHSA-5p2g-fcmc-qvqq",
        "GHSA-w3rx-r6r6-pgpr"
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^24.2.1",
    "eslint": "^9.33.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.5",
    "openapi-typescript-codegen": "^0.29.0",
    "supabase": "^2.122.1",
    "typescript": "^5.9.2"
  },
  "scripts": {
    "lint": "eslint . && pnpm -C apps/web lint",
    "lint:fix": "eslint . --fix && pnpm -C apps/web exec eslint . --fix",
    "check:docs-links": "node scripts/check-doc-links.mjs",
    "check:hotspots": "node scripts/check-hotspot-sizes.mjs",
    "check:mobile-utf8": "node scripts/check-mobile-utf8.mjs",
    "typecheck": "pnpm -C apps/web typecheck && pnpm -C apps/mobile typecheck",
    "prepare": "husky",
    "supabase": "supabase",
    "db:push": "supabase db push",
    "test:sql": "node scripts/run-sql-tests.mjs",
    "test:api": "pnpm -C apps/web test",
    "test:e2e": "pnpm -C apps/web test:e2e",
    "test": "pnpm test:api",
    "generate:sdk": "node scripts/generate-sdk.mjs",
    "generate:api-route": "node scripts/generate-api-route.mjs",
    "test:sql:isolated": "node scripts/run-isolated-sql-tests.mjs",
    "generate:openapi": "node scripts/generate-openapi.mjs --write",
    "check:openapi": "node scripts/generate-openapi.mjs --check",
    "check:crons": "node scripts/generate-cron-manifests.mjs --check",
    "db:start:check": "supabase start -x studio,imgproxy,edge-runtime,logflare,vector,supavisor,realtime,postgres-meta,mailpit",
    "generate:db-types": "node scripts/generate-db-types.mjs --write",
    "check:db-types": "node scripts/generate-db-types.mjs --check",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:encoding": "node scripts/check-encoding.mjs",
    "check:sql-functions": "node scripts/check-sql-functions.mjs",
    "check:silent-errors": "node scripts/check-silent-server-errors.mjs"
  },
  "lint-staged": {
    "apps/web/**/*.{js,jsx,ts,tsx,mjs}": [
      "pnpm -C apps/web exec eslint --fix --no-warn-ignored"
    ],
    "{scripts,packages}/**/*.{js,mjs,cjs}": [
      "eslint --fix --no-warn-ignored"
    ]
  },
  "packageManager": "pnpm@10.28.0"
}
