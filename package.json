{
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "next": "16",
        "react": "19",
        "react-dom": "19",
        "tree-sitter": "0.22"
      }
    },
    "overrides": {
      "tar": ">=7.5.8",
      "@isaacs/brace-expansion": ">=5.0.1",
      "axios": ">=1.13.5"
    }
  },
  "devDependencies": {
    "@types/node": "^24.2.1",
    "eslint": "^9.33.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.5",
    "openapi-typescript-codegen": "^0.29.0",
    "supabase": "^2.34.3",
    "typescript": "^5.9.2"
  },
  "scripts": {
    "lint": "eslint . && pnpm -C apps/web lint",
    "lint:fix": "eslint . --fix && pnpm -C apps/web exec eslint . --fix",
    "check:docs-links": "node scripts/check-doc-links.mjs",
    "check:hotspots": "node scripts/check-hotspot-sizes.mjs",
    "check:mobile-utf8": "node scripts/check-mobile-utf8.mjs",
    "typecheck": "pnpm -C apps/web typecheck && pnpm -C apps/mobile typecheck",
    "prepare": "husky",
    "supabase": "supabase",
    "db:push": "supabase db push",
    "test:sql": "node scripts/run-sql-tests.mjs",
    "test:api": "pnpm -C apps/web test",
    "test:e2e": "pnpm -C apps/web test:e2e",
    "test": "pnpm test:sql && pnpm test:api",
    "generate:sdk": "node scripts/generate-sdk.mjs",
    "generate:api-route": "node scripts/generate-api-route.mjs",
    "test:sql:isolated": "node scripts/run-isolated-sql-tests.mjs",
    "generate:openapi": "node scripts/generate-openapi.mjs --write",
    "check:openapi": "node scripts/generate-openapi.mjs --check",
    "check:crons": "node scripts/generate-cron-manifests.mjs --check"
  },
  "lint-staged": {
    "apps/web/**/*.{js,jsx,ts,tsx,mjs}": [
      "pnpm -C apps/web exec eslint --fix --no-warn-ignored"
    ],
    "{scripts,packages}/**/*.{js,mjs,cjs}": [
      "eslint --fix --no-warn-ignored"
    ]
  },
  "packageManager": "pnpm@10.28.0"
}
