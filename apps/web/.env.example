# Kezek web (apps/web): every environment variable the code reads.
# Copy to apps/web/.env.local (never overwrite an existing one) and fill in values for YOUR environment.
# No real values in this file or in Git. NEXT_PUBLIC_* values reach the browser: never put secrets there.
# [required]       the app does not work without it
# [required prod]  needed in production (or for the named feature); local development works without it
# [optional]       has a default or switches a feature on; leaving it empty is safe
# Reference: ENV_GUIDE.md (purpose, defaults, what happens when a value is missing).

# --- Supabase -------------------------------------------------------------------------------
# [required] Supabase project URL (browser and server)
NEXT_PUBLIC_SUPABASE_URL=
# [required] Public anon key of the same project; RLS still applies
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# [required] Service role key, server only: bypasses RLS, always scoped by biz_id in code
SUPABASE_SERVICE_ROLE_KEY=

# --- Site -----------------------------------------------------------------------------------
# [optional] Public origin for links and auth returns (default https://kezek.vercel.app; locally http://localhost:3000)
NEXT_PUBLIC_SITE_ORIGIN=
# [optional] Application time zone (default Asia/Bishkek)
NEXT_PUBLIC_TZ=
# [optional] Yandex Maps JavaScript API key for maps and address search
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=
# [optional] Development only: public HTTPS tunnel origin used for OAuth callbacks instead of the request origin
LOCAL_AUTH_PUBLIC_ORIGIN=
# [optional] Development only: older name of LOCAL_AUTH_PUBLIC_ORIGIN for the Yandex OAuth flow
YANDEX_OAUTH_PUBLIC_ORIGIN=
# [optional] Comma-separated SHA-256 signing-key fingerprints of the Android app for /.well-known/assetlinks.json
ANDROID_APP_LINK_SHA256_FINGERPRINTS=

# --- Cron -----------------------------------------------------------------------------------
# [required prod] Shared secret every /api/cron/* handler checks (Vercel and pg_cron send it)
CRON_SECRET=
# [optional] Fallback name for CRON_SECRET in older cron handlers
VERCEL_CRON_SECRET=

# --- Rate limits and caches (Upstash Redis) -------------------------------------------------
# [required prod] Upstash Redis REST URL for rate limits and performance aggregates
UPSTASH_REDIS_REST_URL=
# [required prod] Upstash Redis REST token
UPSTASH_REDIS_REST_TOKEN=
# [optional] Vercel Marketplace name for UPSTASH_REDIS_REST_URL (used when the Upstash name is empty)
KV_REST_API_URL=
# [optional] Vercel Marketplace name for UPSTASH_REDIS_REST_TOKEN
KV_REST_API_TOKEN=
# [required prod] Name of the single-IP request header the edge overwrites (see RATE_LIMITING.md); without it production IP limits answer 503
RATE_LIMIT_TRUSTED_IP_HEADER=

# --- E-mail (Resend) and alerts -------------------------------------------------------------
# [required prod] Resend API key for e-mail notifications and alerts
RESEND_API_KEY=
# [required prod] Sender address on a domain verified in Resend; empty means no e-mail is sent
EMAIL_FROM=
# [optional] Recipient of health-check and cron failure alerts
ALERT_EMAIL_TO=

# --- Notification workers -------------------------------------------------------------------
# [optional] Exactly "true" lets the cron send the queued booking notifications (outbox)
BOOKING_NOTIFICATION_WORKER_ENABLED=
# [optional] Exactly "true" lets the cron process stored incoming WhatsApp messages
WHATSAPP_INBOX_WORKER_ENABLED=
# [optional] Expo access token for push notifications (needed only with Expo "enhanced push security")
EXPO_ACCESS_TOKEN=

# --- WhatsApp (Meta Cloud API) --------------------------------------------------------------
# [required prod] Access token of the WhatsApp Business account (notifications, OTP)
WHATSAPP_ACCESS_TOKEN=
# [required prod] Phone number id of the sending WhatsApp number
WHATSAPP_PHONE_NUMBER_ID=
# [required prod] Meta app secret: verifies the HMAC signature of incoming webhooks (POST answers 503 without it)
WHATSAPP_APP_SECRET=
# [optional] Token Meta echoes when the webhook is verified (has a development default)
WHATSAPP_VERIFY_TOKEN=
# [required prod] HMAC key for WhatsApp OTP codes and phone numbers; production OTP flows answer 503 without it
WHATSAPP_OTP_HASH_SECRET=
# [optional] Graph API version, e.g. v21.0 (code default otherwise)
WHATSAPP_GRAPH_API_VERSION=
# [optional] Approved template for OTP sign-in codes
WHATSAPP_OTP_TEMPLATE_NAME=
# [optional] Language code of the OTP template
WHATSAPP_OTP_TEMPLATE_LANG=
# [optional] OTP template strategy: utility (default) or authentication
WHATSAPP_OTP_TEMPLATE_TYPE=
# [optional] JSON components of the OTP template; {{OTP_CODE}} is replaced by the code
WHATSAPP_OTP_TEMPLATE_COMPONENTS_JSON=
# [optional] Older name of the OTP template (used when WHATSAPP_OTP_TEMPLATE_NAME is empty)
WHATSAPP_AUTH_TEMPLATE_NAME=
# [optional] Older name of the OTP template language (default ru)
WHATSAPP_AUTH_TEMPLATE_LANGUAGE=
# [optional] Approved template for a confirmed booking; empty means no WhatsApp message of that kind
WHATSAPP_BOOKING_CONFIRMED_TEMPLATE_NAME=
# [optional] Approved template for a cancelled booking
WHATSAPP_BOOKING_CANCELLED_TEMPLATE_NAME=
# [optional] Approved template for a booking reminder
WHATSAPP_BOOKING_REMINDER_TEMPLATE_NAME=
# [optional] Default language of the booking templates (default ru)
WHATSAPP_BOOKING_TEMPLATE_LANG=
# [optional] Kyrgyz translation code of the booking templates, once approved
WHATSAPP_BOOKING_TEMPLATE_LANG_KY=
# [optional] English translation code of the booking templates, once approved
WHATSAPP_BOOKING_TEMPLATE_LANG_EN=
# [optional] Language of the application templates below
WHATSAPP_APPLICATION_TEMPLATE_LANGUAGE=
# [optional] JSON: named template parameters per application message type (positional otherwise)
WHATSAPP_APPLICATION_NAMED_PARAMETERS=
# [optional] Template: new staff application, to the business owner
WHATSAPP_STAFF_APPLICATION_OWNER_TEMPLATE_NAME=
# [optional] Template: staff application received, to the applicant
WHATSAPP_STAFF_APPLICATION_APPLICANT_TEMPLATE_NAME=
# [optional] Template: staff application approved, to the applicant
WHATSAPP_STAFF_APPLICATION_APPROVED_TEMPLATE_NAME=
# [optional] Template: business application received, to the applicant
WHATSAPP_BUSINESS_APPLICATION_APPLICANT_TEMPLATE_NAME=
# [optional] Template: new business application, to the platform admin
WHATSAPP_BUSINESS_APPLICATION_ADMIN_TEMPLATE_NAME=
# [optional] Template: business application approved, to the applicant
WHATSAPP_BUSINESS_APPLICATION_APPROVED_TEMPLATE_NAME=
# [optional] Template: owner application received, to the applicant
WHATSAPP_OWNER_APPLICATION_APPLICANT_TEMPLATE_NAME=
# [optional] Template: new owner application, to the platform admin
WHATSAPP_OWNER_APPLICATION_ADMIN_TEMPLATE_NAME=
# [optional] Template: owner application approved, to the applicant
WHATSAPP_OWNER_APPLICATION_APPROVED_TEMPLATE_NAME=

# --- Telegram -------------------------------------------------------------------------------
# [required prod] Bot token: notifications, bot sign-in and profile linking
TELEGRAM_BOT_TOKEN=
# [required prod] Secret Telegram sends with webhook calls (setWebhook secret_token)
TELEGRAM_WEBHOOK_SECRET=
# [required prod] Secret of the mobile sign-in bot callbacks (mobile Telegram deep-link sign-in)
TELEGRAM_MOBILE_BOT_SECRET=
# [optional] Bot username without @ for the login and link widgets
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
# [optional] "true" shows sign-in through the Telegram bot
NEXT_PUBLIC_TELEGRAM_BOT_LOGIN_ENABLED=
# [optional] "true" shows Telegram linking in the profile
NEXT_PUBLIC_TELEGRAM_BOT_LINK_ENABLED=

# --- Mobile auth feature flags --------------------------------------------------------------
# [optional] Server switch for mobile WhatsApp sign-in
MOBILE_WHATSAPP_AUTH=
# [optional] Public fallback of MOBILE_WHATSAPP_AUTH (also shown on the web sign-in page)
NEXT_PUBLIC_MOBILE_WHATSAPP_AUTH=
# [optional] Share of users (0-100) who get mobile WhatsApp sign-in
MOBILE_WHATSAPP_AUTH_ROLLOUT_PERCENT=
# [optional] Server switch for mobile Telegram deep-link sign-in
MOBILE_TELEGRAM_DEEPLINK_AUTH=
# [optional] Public fallback of MOBILE_TELEGRAM_DEEPLINK_AUTH
NEXT_PUBLIC_MOBILE_TELEGRAM_DEEPLINK_AUTH=
# [optional] Share of users (0-100) who get mobile Telegram deep-link sign-in
MOBILE_TELEGRAM_DEEPLINK_AUTH_ROLLOUT_PERCENT=

# --- Scheduling -----------------------------------------------------------------------------
# [optional] Exactly "true" switches on the explicit staff schedule model (v2)
SCHEDULE_V2_ENABLED=

# --- SMS (legacy sender) --------------------------------------------------------------------
# [optional] SMS provider: twilio (default) or webhook
SMS_PROVIDER=
# [optional] Twilio account SID
TWILIO_ACCOUNT_SID=
# [optional] Twilio auth token
TWILIO_AUTH_TOKEN=
# [optional] Twilio sender number
TWILIO_FROM=
# [optional] URL of the webhook SMS provider
SMS_WEBHOOK_URL=
# [optional] Bearer token of the webhook SMS provider
SMS_WEBHOOK_TOKEN=

# --- Monitoring (Sentry) --------------------------------------------------------------------
# [optional] Sentry DSN; switches on error reporting in browser, server and edge (build-time, redeploy after a change)
NEXT_PUBLIC_SENTRY_DSN=
# [optional] Environment label of Sentry events (default vercel-production / vercel-preview / NODE_ENV)
SENTRY_ENVIRONMENT=
# [optional] Build only: Sentry organization slug for source map upload
SENTRY_ORG=
# [optional] Build only: Sentry project slug for source map upload
SENTRY_PROJECT=
# [optional] Build only, secret: Sentry auth token for source map upload (Vercel build env, never in Git)
SENTRY_AUTH_TOKEN=

# --- E2E tests (Playwright; usually written to e2e/.e2e.env by scripts/e2e-seed.mjs) ---------
# [optional] Path of the E2E env file (default e2e/.e2e.env)
E2E_ENV_FILE=
# [optional] Port of the app under test
E2E_PORT=
# [optional] Base URL of an already running app under test
PLAYWRIGHT_TEST_BASE_URL=
# [optional] "start" serves a production build instead of next dev
E2E_WEB_SERVER=
# [optional] Non-empty: do not start a web server (the app is already served)
E2E_SKIP_WEB_SERVER=
# [optional] Supabase Auth URL reachable from the test runner, when it differs from NEXT_PUBLIC_SUPABASE_URL
E2E_SUPABASE_AUTH_URL=
# [optional] Fixed "today" (YYYY-MM-DD) for date-dependent flows
E2E_TEST_TODAY=
# [optional] Fixture business id
E2E_TEST_BUSINESS_ID=
# [optional] Fixture business slug
E2E_TEST_BUSINESS_SLUG=
# [optional] Fixture branch id
E2E_TEST_BRANCH_ID=
# [optional] Fixture staff id
E2E_TEST_STAFF_ID=
# [optional] Fixture client account e-mail
E2E_TEST_CLIENT_EMAIL=
# [optional] Search text that finds the fixture client
E2E_TEST_CLIENT_SEARCH=
# [optional] Fixture manager account e-mail
E2E_TEST_MANAGER_EMAIL=
# [optional] Fixture staff account e-mail
E2E_TEST_STAFF_EMAIL=
# [optional] Fixture account with several roles
E2E_TEST_MULTI_ROLE_EMAIL=
# [optional] Fixture super admin e-mail
E2E_TEST_SUPER_ADMIN_EMAIL=
# [optional] Fixture super admin e-mail as the branch-map spec names it
E2E_TEST_SUPERADMIN_EMAIL=
# [optional] Password of the fixture accounts (local test data only)
E2E_TEST_PASSWORD=
# [optional] Password of the fixture staff account, when it differs
E2E_TEST_STAFF_PASSWORD=

# --- Set by the platform; do not set by hand -------------------------------------------------
# NODE_ENV (Next.js), NEXT_RUNTIME (Next.js: nodejs / edge), CI (CI runners), TZ (server process time zone)
