# Только для локального тестирования Telegram. Не добавляйте реальные значения в Git.
# Скопируйте файл как telegram-test.env.local и заполните значения тестового бота.
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
NEXT_PUBLIC_TELEGRAM_BOT_LOGIN_ENABLED=false

# HTTPS-адрес временного туннеля, например https://example.loca.lt
PUBLIC_TUNNEL_URL=

# Ссылки в уведомлениях используют тот же PUBLIC_TUNNEL_URL через локальный запуск.
# Для именованных WhatsApp-шаблонов задайте в apps/web/.env.local:
# WHATSAPP_APPLICATION_NAMED_PARAMETERS={"staff_owner":["<имя переменной бизнеса>","<имя переменной сотрудника>"]}
# Имена нужно скопировать из утверждённого шаблона Meta, не использовать пример буквально.
# Неуказанные типы используют позиционные параметры. Формат задаётся отдельно для каждого типа.

# Только для отдельного тестового Яндекс OAuth-приложения. Не используйте production-ключи.
YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_CLIENT_SECRET=
