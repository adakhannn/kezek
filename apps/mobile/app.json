{
  "expo": {
    "name": "Kezek",
    "slug": "kezek-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "kezek",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#030712"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "kg.kezek.app",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#030712"
      },
      "package": "kg.kezek.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "kezek.vercel.app",
              "pathPrefix": "/b/"
            },
            {
              "scheme": "https",
              "host": "kezek.vercel.app",
              "pathPrefix": "/booking/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "kezek"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#4f46e5",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Kezek использует геолокацию, чтобы показать ближайшие филиалы."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Kezek открывает галерею, чтобы вы выбрали фото профиля мастера.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "locales": {
      "ru": "./locales/ru.json",
      "ky": "./locales/ky.json",
      "en": "./locales/en.json"
    },
    "extra": {
      "eas": {
        "projectId": "f57c6b68-5764-4273-afe5-99f2d8fd5e89"
      }
    },
    "owner": "adakhann"
  }
}
