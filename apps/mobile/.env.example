# ===========================================
# Kezek Mobile — переменные окружения
# Скопируйте в .env.local и заполните значения.
# .env.local не коммитится в git.
# ===========================================
# Подробнее: ENV_GUIDE.md в корне репозитория (раздел «2. Mobile»)

# Supabase (обязательно)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# URL веб-приложения (API, бронирование)
EXPO_PUBLIC_API_URL=https://kezek.vercel.app

# Telegram mobile deep-link auth feature flag
EXPO_PUBLIC_MOBILE_TELEGRAM_DEEPLINK_AUTH=true

# Отчёты о сбоях (MOB-07): DSN проекта Sentry; development-сборки ничего не отправляют
# EXPO_PUBLIC_SENTRY_DSN=

# Карта «Выбрать на карте» в форме филиала: тот же ключ Yandex Maps JS API, что у сайта
# (NEXT_PUBLIC_YANDEX_MAPS_API_KEY); без него карта показывает «Карта не настроена»
# EXPO_PUBLIC_YANDEX_MAPS_API_KEY=
